{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/.*|assets/.*|favicon.ico).*)",
      "destination": "/index.html"
    }
  ]
}
